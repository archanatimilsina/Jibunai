{
  "cli": {
    "version": ">= 26.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://10.0.2.2:8000"
      }
    },
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "${{EXPO_PUBLIC_API_URL}}"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_API_URL": "${{EXPO_PUBLIC_API_URL}}"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
