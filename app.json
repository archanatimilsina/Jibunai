{
  "expo": {
    "name": "Jibunai",
    "slug": "jibunai",
    "scheme": "jibunai",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f6f5f0",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-artwork.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#f6f5f0"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2d6a4f"
        }
      ],
      "expo-audio",
      "expo-music-library",
      "expo-sharing",
      "expo-asset"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.archanatimilsina.jibunai",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow Jibunai to access your photos so you can attach images to your memories.",
        "NSPhotoLibraryAddUsageDescription": "Allow Jibunai to save images to your photo library.",
        "NSAppleMusicUsageDescription": "Allow Jibunai to play music from your library."
      }
    },
    "android": {
      "package": "com.archanatimilsina.jibunai",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "SCHEDULE_EXACT_ALARM",
        "READ_MEDIA_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#f6f5f0",
        "backgroundImage": "./assets/android-icon-background.png",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "bca138a4-72fd-498c-877c-e46ecb4f6d87"
      }
    },
    "owner": "0727hannah"
  }
}
