# Base URL of the Django backend (without the trailing /api).
# Leave empty to use the Vite dev proxy (http://127.0.0.1:8000) locally.
# Production (new): https://portfolio-79vi.onrender.com
# Production (legacy Jibunai service, still accepted by backend CORS/CSRF):
# https://jibunai.onrender.com
VITE_API_URL="https://portfolio-79vi.onrender.com"
# Editor token so web writes pass the API's login-required rule.
# Mint with: cd backend && python manage.py make_editor_token
# Reads work without it; creates/edits/deletes 403 without it.
VITE_API_TOKEN=""
