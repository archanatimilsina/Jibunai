{
  "name": "jibunai",
  "version": "1.0.0",
  "main": "index.js",
  "private": true,
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android --device",
    "android:emulator": "expo run:android",
    "ios": "expo run:ios --device",
    "prebuild": "expo prebuild --clean",
    "web": "expo start --web",
    "build:web": "cd web && npm run build",
    "install:web": "cd web && npm install",
    "dev:web": "cd web && npm run dev",
    "backend:install": "cd backend && pip install -r requirements.txt",
    "backend:start": "cd backend && python manage.py runserver 0.0.0.0:8000",
    "backend:migrate": "cd backend && python manage.py migrate",
    "backend:check": "cd backend && python manage.py check",
    "mongo": "docker compose up -d mongo",
    "stack:up": "docker compose up -d"
  },
  "dependencies": {
    "@expo-google-fonts/dm-mono": "^0.4.2",
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@expo-google-fonts/syne": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "expo": "~57.0.31",
    "expo-asset": "57.0.20",
    "expo-audio": "~57.0.5",
    "expo-clipboard": "~57.0.2",
    "expo-dev-client": "~57.0.20",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-media-library": "~57.0.5",
    "expo-music-library": "^1.3.2",
    "expo-notifications": "~57.0.7",
    "expo-print": "~57.0.2",
    "expo-secure-store": "~57.0.2",
    "expo-sharing": "~57.0.24",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^1.51.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-webview": "13.16.1"
  }
}
